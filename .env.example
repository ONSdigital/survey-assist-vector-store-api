# Copy this file to .env and adjust values for your environment.

# API runtime settings
# Optional: defaults to `vector_store`. When using `compose.yaml`, set this to
# the local artifact directory you want mounted into the vector-store container
# (`vector-store-api` in Compose). To switch taxonomies locally, update this
# value to the matching directory.
VECTOR_STORE_DIR=vector_store
# Optional: defaults to `20`.
VECTOR_STORE_K_MATCHES=20
# Optional for the SAYT API runtime: defaults to `sayt_artifact`. When using
# `compose.yaml`, set this to the local SAYT artifact directory you want mounted
# into the SAYT container (`sayt-api` in Compose).
SAYT_ARTIFACT_DIR=sayt_artifact

# Vector-store build settings
# Required when running `make build-vector-store` or
# `poetry run python scripts/build_vector_store_artifacts.py`.
INDEX_SOURCE_FILE=path/to/source.csv

# Optional: omit to use the embed-core default model.
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# SAYT build settings
# Required when running `make build-sayt` or
# `poetry run python scripts/build_sayt_artifacts.py`.
SAYT_SOURCE_FILE=path/to/sayt_source.csv

# Optional: defaults to `search_text`.
SEARCH_TEXT_COL=search_text
# Optional: defaults to `display_text`.
DISPLAY_TEXT_COL=display_text
# Optional: defaults to `3`.
MIN_CHARS=3
# Optional: defaults to `10`. This becomes the artifact default used when
# API requests omit `limit`.
DEFAULT_NUM_SUGGESTIONS=10

# Local runtime ports for direct `make run-*` commands and Compose host ports
# VECTOR_STORE_PORT=8088
# SAYT_PORT=8090

# Example alternative local artifact directories for a different taxonomy
# VECTOR_STORE_DIR=vector_store_soc
# SAYT_ARTIFACT_DIR=sayt_artifact_soc
